# ── Ticketmaster Discovery API ────────────────────────────────────────────────
# Get a free key at https://developer.ticketmaster.com/ (5,000 calls/day free)
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Leave blank — the script auto-discovers Barclays Center's venue ID on each run.
# Set this to the discovered ID to skip the lookup call (e.g. KovZpZAEdFtA).
TICKETMASTER_VENUE_ID=

# How many days ahead to include events (default: 14)
DAYS_AHEAD=14

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Works with Gmail, Outlook, iCloud Mail, or any SMTP provider.
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Paste it as SMTP_PASSWORD below (spaces OK, they're ignored)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Display name shown in the From: field
FROM_NAME=Barclays Center Newsletter
# Defaults to SMTP_USER if left blank
FROM_EMAIL=
